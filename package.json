{
  "name": "md-rag",
  "version": "0.1.0",
  "description": "Serves a Git repository of Markdown files to AI agents via in-process hybrid search.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "md-rag": "node src/cli/main.ts",
    "start": "node src/cli/main.ts serve",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:models": "vitest run --config vitest.models.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "lefthook": "^2.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "micromark-extension-frontmatter": "^2.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
