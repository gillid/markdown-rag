{
  "name": "markdown-rag",
  "version": "0.1.2",
  "description": "Serves a Git repository of Markdown files to AI agents via in-process hybrid search.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gillid/md-rag.git"
  },
  "homepage": "https://github.com/gillid/md-rag#readme",
  "bugs": "https://github.com/gillid/md-rag/issues",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "bin": {
    "markdown-rag": "./src/cli/main.ts"
  },
  "exports": {
    ".": "./src/engine/index.ts"
  },
  "files": [
    "dist/",
    "docs/agent-guide.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "bin": {
      "markdown-rag": "./dist/cli/main.js"
    },
    "exports": {
      ".": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine/index.js"
      }
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test:pack": "node scripts/pack-smoke.ts",
    "markdown-rag": "node src/cli/main.ts",
    "start": "node src/cli/main.ts serve",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:models": "vitest run --config vitest.models.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "lefthook": "^2.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "peerDependencies": {
    "@types/node": ">=24"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@orama/orama": "^3.1.18",
    "@orama/stopwords": "^3.1.18",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
